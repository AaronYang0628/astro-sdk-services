        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (le) (increase(astro_tool_duration_seconds_bucket{job=\"asa_obs\", asa_cluster=~\"$cluster\", sdk=~\"$sdk\", tool=~\"$tool\"}[$__rate_interval]))",
          "legendFormat": "{{le}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,

          "steps": 64,
          "reverse": true,
          "exponent": 0.5
        },
        "cellGap": 1,
        "tooltip": {
          "mode": "single",
          "yHistogram": true
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "filterValues": {
          "le": 1e-09
        }
      }
    },

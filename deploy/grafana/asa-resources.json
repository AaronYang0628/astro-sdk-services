            },
            "renameByName": {
              "k8s_namespace_name": "Namespace",
              "k8s_pod_name": "Pod",
              "k8s_container_name": "Container",
              "Value #A": "Mem used",
              "Value #B": "Mem request",
              "Value #C": "Mem limit",
              "Value #D": "CPU (cores)",
              "Value #E": "Restarts"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Mem used",
                "desc": true
              }
            ]
          }
        }
      ]

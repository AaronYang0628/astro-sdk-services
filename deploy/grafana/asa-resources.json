          "expr": "sum by (k8s_namespace_name, k8s_pod_name) (asa_k8s_pod_memory_working_set_bytes{job=\"asa_obs\", asa_cluster=~\"$cluster\", k8s_namespace_name=~\"$namespace\", k8s_pod_name=~\"$pod\"})",

{
  "uid": "asa-resources",
  "title": "ASA · Pod Resources",
  "description": "Pod / container / node CPU and memory",
  "tags": [
    "asa",
    "observability",
    "resources"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(asa_up{job=\"asa_obs\"}, asa_cluster)",
          "refId": "v"
        },
        "definition": "label_values(asa_up{job=\"asa_obs\"}, asa_cluster)",
        "refresh": 2,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(asa_k8s_pod_memory_working_set_bytes{job=\"asa_obs\", asa_cluster=~\"$cluster\"}, k8s_namespace_name)",
          "refId": "v"
        },
        "definition": "label_values(asa_k8s_pod_memory_working_set_bytes{job=\"asa_obs\", asa_cluster=~\"$cluster\"}, k8s_namespace_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "sort": 1,
        "current": {
          "text": [
            "astro-sdk",
            "observability"
          ],
          "value": [
            "astro-sdk",
            "observability"
          ]
        }
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(asa_k8s_pod_memory_working_set_bytes{job=\"asa_obs\", asa_cluster=~\"$cluster\", k8s_namespace_name=~\"$namespace\"}, k8s_pod_name)",
          "refId": "v"
        },
        "definition": "label_values(asa_k8s_pod_memory_working_set_bytes{job=\"asa_obs\", asa_cluster=~\"$cluster\", k8s_namespace_name=~\"$namespace\"}, k8s_pod_name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },

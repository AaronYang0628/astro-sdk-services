  {
    "name": "euclid_cutout2d",
    "target": "euclid_cutout.cutout2d",
    "desc": "按天体源 (ra,dec 度) 做 Cutout2D（与 Euclid-Image-Cutout-Service.cutout_image 一致：WCS(header)+SkyCoord+像素 size，默认 1024）。不要传 fov_center。写出 PrimaryHDU 裁剪 FITS。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "euclid_fetch_fits 返回的服务端缓存 path（仅允许缓存/输出目录内的文件）"
      },
      {
        "name": "ra",
        "type": "float",
        "required": true,
        "desc": "源赤经（度）— 星表/峰值坐标，不是视场中心"
      },
      {
        "name": "dec",
        "type": "float",
        "required": true,
        "desc": "源赤纬（度）"
      },
      {
        "name": "size",
        "type": "int",
        "required": false,
        "desc": "边长像素（默认 1024）；也可 {\"value\":10,\"unit\":\"arcsec\"}"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "图像 HDU；Euclid VIS MEF 通常为 1（勿用空 PRIMARY=0）"
      },
      {
        "name": "output_path",
        "type": "str",
        "required": false,
        "desc": "（可选）输出文件名或 EUCLID_OUTPUT_DIR 内的相对路径；一般省略"
      },
      {
        "name": "obj_id",
        "type": "str",
        "required": false,
        "desc": "目标名，用于默认文件名"
      },
      {
        "name": "mode",
        "type": "str",
        "required": false,
        "desc": "Cutout2D mode：partial|trim|strict"
      },
      {
        "name": "fill_value",
        "type": "float",
        "required": false,
        "desc": "越界填充值"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "Cutout2D写FITS",
    "timeout": 120,
    "raw_args": true
  },
  {
    "name": "euclid_write_preview",
    "target": "euclid_cutout.write_preview",
    "desc": "把裁剪（或任意）图像 FITS 写成 quicklook PNG/JPG（最长边 ≤ max_side，默认 1024）。拉伸：忽略 NaN/inf；忽略 partial cutout 的零填充；默认 1–99 百分位 + asinh。MCP 调用会把预览缩略图作为图片内容块直接返回，可直接展示给用户（inline_image=false 可关闭）；完整裁剪 FITS 保留在服务端。",
    "params": [
      {
        "name": "fits_path",
        "type": "str",
        "required": true,
        "desc": "euclid_cutout2d 返回的 fits_path"
      },
      {
        "name": "output_path",
        "type": "str",
        "required": false,
        "desc": "（可选）输出文件名或 EUCLID_OUTPUT_DIR 内的相对路径；一般省略"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "图像 HDU"
      },
      {
        "name": "format",
        "type": "str",
        "required": false,
        "desc": "png 或 jpg，默认 png"
      },
      {
        "name": "p_low",
        "type": "float",
        "required": false,
        "desc": "显示拉伸低百分位，默认 1"
      },
      {
        "name": "p_high",
        "type": "float",
        "required": false,
        "desc": "显示拉伸高百分位，默认 99"
      },
      {
        "name": "dpi",
        "type": "int",
        "required": false,
        "desc": "输出 DPI，默认 120"
      },
      {
        "name": "max_side",
        "type": "int",
        "required": false,
        "desc": "预览图最长边像素上限，默认 1024"
      },
      {
        "name": "inline_image",
        "type": "bool",
        "required": false,
        "desc": "是否在 MCP 结果中内嵌图片块，默认 true"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "写预览PNG/JPG",
    "raw_args": true
  },

[
  {
    "name": "euclid_get_config",
    "target": "euclid_cutout.get_config",
    "desc": "查看 EUCLID_CACHE_DIR / EUCLID_OUTPUT_DIR / EUCLID_MER_ROOT / EUCLID_TILE_INDEX 等路径是否就绪。",
    "params": [],
    "domain": "Euclid裁剪",
    "cn": "查看配置",
    "raw_args": true
  },
  {
    "name": "euclid_fetch_fits",
    "target": "euclid_cutout.fetch_fits",
    "desc": "下载一个 http(s) FITS URL 到服务端缓存，返回后续工具使用的 path。URL 可以是公开的 FITS 链接，也可以是 021 为上传文件生成的临时（预签名）OSS 地址——请原样传入完整 URL（含 ? 后的签名参数）。不接受本地路径。多 GB 文件请设 max_bytes（如 25000000）只取前缀（HTTP Range；服务器不支持 Range 时自动流式截断）。临时 URL 过期会返回明确错误，请让用户重新获取链接。按文件内容（SIMPLE 头）识别 FITS，支持 .fits/.fit/.fts/.fz 及无扩展名。",
    "params": [
      {
        "name": "url",
        "type": "str",
        "required": true,
        "desc": "http(s) FITS URL：公开链接，或 021 上传文件的临时 OSS/S3 预签名地址（完整传入，含查询参数）"
      },
      {
        "name": "force",
        "type": "bool",
        "required": false,
        "desc": "忽略缓存重新下载"
      },
      {
        "name": "max_bytes",
        "type": "int",
        "required": false,
        "desc": "只下载前 N 字节（多 GB 文件建议 25000000）"
      },
      {
        "name": "timeout",
        "type": "int",
        "required": false,
        "desc": "下载超时秒数，默认 600"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "获取FITS到本地缓存",
    "timeout": 600,
    "raw_args": true
  },
  {
    "name": "euclid_list_hdus",
    "target": "euclid_cutout.list_hdus",
    "desc": "列出已下载 FITS（euclid_fetch_fits 返回的 path）的 HDU（index/name/shape/是否含 WCS）。前缀下载的文件可能只有前面若干完整 HDU。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "euclid_fetch_fits 返回的服务端缓存 path（仅允许缓存/输出目录内的文件）"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "列出FITS扩展",
    "raw_args": true
  },
  {
    "name": "euclid_read_wcs_header",

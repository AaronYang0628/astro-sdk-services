    "desc": "读取图像 HDU 的 WCS。返回 fov_center/crval（视场中心，通常是一片背景），切勿当作天体源坐标去 cutout；源坐标应来自星表或 euclid_find_peak_sky。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "euclid_fetch_fits 返回的服务端缓存 path（仅允许缓存/输出目录内的文件）"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "HDU 序号，缺省自动选择"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "读取WCS头",
    "raw_args": true
  },

[
  {
    "name": "euclid_get_config",
    "target": "euclid_cutout.get_config",
    "desc": "查看 EUCLID_CACHE_DIR / EUCLID_OUTPUT_DIR / EUCLID_MER_ROOT / EUCLID_TILE_INDEX 等路径是否就绪。",
    "params": [],
    "domain": "Euclid裁剪",
    "cn": "查看配置"
  },
  {
    "name": "euclid_fetch_fits",
    "target": "euclid_cutout.fetch_fits",
    "desc": "打开本地 FITS 路径，或将 HTTPS FITS URL 下载到 EUCLID_CACHE_DIR（支持 Range 断点续传）。对多 GB 镜像可设 max_bytes 只拉文件前缀（早期扩展足够做 cutout 时）。返回本地 path。",
    "params": [
      {
        "name": "url_or_path",
        "type": "str",
        "required": true,
        "desc": "本地路径或 https://...fits"
      },
      {
        "name": "force",
        "type": "bool",
        "required": false,
        "desc": "强制重新下载"
      },
      {
        "name": "max_bytes",
        "type": "int",
        "required": false,
        "desc": "最多下载字节数（前缀）；大文件 cutout 常用 20–50MB"
      },
      {
        "name": "timeout",
        "type": "int",
        "required": false,
        "desc": "下载超时秒数，默认 600"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "获取FITS到本地缓存",
    "timeout": 600
  },
  {
    "name": "euclid_list_hdus",
    "target": "euclid_cutout.list_hdus",
    "desc": "列出本地 FITS 的 HDU（index/name/shape/是否含 WCS）。前缀下载的文件可能只有前面若干完整 HDU。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "fetch_fits 返回的本地路径"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "列出FITS扩展"
  },
  {
    "name": "euclid_read_wcs_header",
    "target": "euclid_cutout.read_wcs_header",
    "desc": "读取图像 HDU 的 WCS。返回 fov_center/crval（视场中心，通常是一片背景），切勿当作天体源坐标去 cutout；源坐标应来自星表或 euclid_find_peak_sky。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "本地 FITS 路径"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "HDU 序号，缺省自动选择"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "读取WCS头"
  },
  {
    "name": "euclid_sky_to_pixel",
    "target": "euclid_cutout.sky_to_pixel",
    "desc": "将天球坐标 (ra,dec 度) 转为像素 (x,y)，并报告是否落在图像内。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "本地 FITS"
      },
      {
        "name": "ra",
        "type": "float",
        "required": true,
        "desc": "赤经 度"
      },
      {
        "name": "dec",
        "type": "float",
        "required": true,
        "desc": "赤纬 度"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "HDU 序号"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "天球到像素"
  },
  {
    "name": "euclid_find_peak_sky",
    "target": "euclid_cutout.find_peak_sky",
    "desc": "在图像中找最亮像素并返回其 (ra,dec)。无星表时的 URL 演示用；有星表时请用星表坐标。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "本地 FITS"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "图像 HDU"
      },
      {
        "name": "box_size",
        "type": "int",
        "required": false,
        "desc": "仅在中心 box_size×box_size 内搜索"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "找峰值天球坐标"
  },
  {
    "name": "euclid_pixel_to_sky",
    "target": "euclid_cutout.pixel_to_sky",
    "desc": "将像素 (x,y) 转为天球 (ra,dec 度)。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "本地 FITS"
      },
      {
        "name": "x",
        "type": "float",
        "required": true,
        "desc": "像素 x（0-based）"
      },
      {
        "name": "y",
        "type": "float",
        "required": true,
        "desc": "像素 y（0-based）"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "HDU 序号"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "像素到天球"
  },
  {
    "name": "euclid_cutout2d",
    "target": "euclid_cutout.cutout2d",
    "desc": "按天体源 (ra,dec 度) 做 Cutout2D（与 Euclid-Image-Cutout-Service.cutout_image 一致：WCS(header)+SkyCoord+像素 size，默认 1024）。不要传 fov_center。写出 PrimaryHDU 裁剪 FITS。",
    "params": [
      {
        "name": "path",
        "type": "str",
        "required": true,
        "desc": "源 FITS 本地路径"
      },
      {
        "name": "ra",
        "type": "float",
        "required": true,
        "desc": "源赤经（度）— 星表/峰值坐标，不是视场中心"
      },
      {
        "name": "dec",
        "type": "float",
        "required": true,
        "desc": "源赤纬（度）"
      },
      {
        "name": "size",
        "type": "int",
        "required": false,
        "desc": "边长像素（默认 1024）；也可 {\"value\":10,\"unit\":\"arcsec\"}"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "图像 HDU；Euclid VIS MEF 通常为 1（勿用空 PRIMARY=0）"
      },
      {
        "name": "output_path",
        "type": "str",
        "required": false,
        "desc": "输出 FITS 路径"
      },
      {
        "name": "obj_id",
        "type": "str",
        "required": false,
        "desc": "目标名，用于默认文件名"
      },
      {
        "name": "mode",
        "type": "str",
        "required": false,
        "desc": "Cutout2D mode：partial|trim|strict"
      },
      {
        "name": "fill_value",
        "type": "float",
        "required": false,
        "desc": "越界填充值"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "Cutout2D写FITS",
    "timeout": 120
  },
  {
    "name": "euclid_write_preview",
    "target": "euclid_cutout.write_preview",
    "desc": "把裁剪（或任意）图像 FITS 写成 quicklook PNG/JPG，便于直接查看。",
    "params": [
      {
        "name": "fits_path",
        "type": "str",
        "required": true,
        "desc": "cutout2d 输出的 FITS"
      },
      {
        "name": "output_path",
        "type": "str",
        "required": false,
        "desc": "预览图路径"
      },
      {
        "name": "hdu_index",
        "type": "int",
        "required": false,
        "desc": "图像 HDU"
      },
      {
        "name": "format",
        "type": "str",
        "required": false,
        "desc": "png 或 jpg，默认 png"
      },
      {
        "name": "p_low",
        "type": "float",
        "required": false,
        "desc": "显示拉伸低百分位，默认 1"
      },
      {
        "name": "p_high",
        "type": "float",
        "required": false,
        "desc": "显示拉伸高百分位，默认 99"
      },
      {
        "name": "dpi",
        "type": "int",
        "required": false,
        "desc": "输出 DPI，默认 120"
      }
    ],
    "domain": "Euclid裁剪",
    "cn": "写预览PNG/JPG"
  },
  {
    "name": "euclid_validate_catalog",
    "target": "euclid_cutout.validate_catalog",
